{
  "annotations": { "list": [] },
  "title": "TNA Logs",
  "uid": "tna-logs",
  "tags": ["tna", "logs"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-1h", "to": "now" },
  "templating": {
    "list": [
      {
        "name": "search",
        "label": "Search",
        "type": "textbox",
        "current": { "text": "", "value": "" },
        "query": "",
        "hide": 0,
        "skipUrlSync": false,
        "description": "Free-text substring filter (case-insensitive)"
      },
      {
        "name": "request_id",
        "label": "request_id",
        "type": "textbox",
        "current": { "text": ".*", "value": ".*" },
        "query": ".*",
        "hide": 0,
        "skipUrlSync": false,
        "description": "Filter to a single extraction trace by request_id"
      },
      {
        "name": "phase",
        "type": "query",
        "label": "Phase",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"tna-service\"}, phase)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"tna-service\"}, agent)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "allValue": ".*",
        "current": { "text": "All", "value": "$__all" },
        "hide": 0,
        "skipUrlSync": false
      },
      {
        "name": "level",
        "type": "query",
        "label": "Level",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"tna-service\"}, level)",
        "refresh": 2,
        "multi": true,
        "includeAll": false,
        "current": {
          "text": ["info", "warning", "error"],
          "value": ["info", "warning", "error"]
        },
        "hide": 0,
        "skipUrlSync": false,
        "description": "Log level filter (debug excluded by default)"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Log lines / min",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"tna-service\"}[1m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 50 },
              { "color": "red", "value": 200 }
            ]
          }
        }
      }
    },
    {
      "id": 2,
      "title": "Errors / min",
      "type": "stat",
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"tna-service\"} | json | __error__=\"\" | level=\"error\" [1m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 3,
      "title": "Active log stream",
      "type": "stat",
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"tna-service\"} | json | __error__=\"\" | level=~\"warning|error\" [1m]))",
          "refId": "A",
          "instant": true
        }
      ],
      "options": {
        "reduceOptions": { "calcs": ["lastNotNull"] },
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 2,
          "displayName": "Warnings+Errors / min",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.1 },
              { "color": "red", "value": 1 }
            ]
          }
        }
      }
    },
    {
      "id": 4,
      "title": "Log volume by level",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 4, "w": 24, "h": 8 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "sum(rate({job=\"tna-service\"} | json | __error__=\"\" [1m])) by (level)",
          "refId": "A",
          "legendFormat": "{{level}}"
        }
      ],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "custom": {
            "fillOpacity": 40,
            "gradientMode": "none",
            "lineWidth": 1,
            "stacking": { "group": "A", "mode": "normal" }
          },
          "unit": "short"
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "error" },
            "properties": [{ "id": "color", "value": { "fixedColor": "red", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "warning" },
            "properties": [{ "id": "color", "value": { "fixedColor": "orange", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "info" },
            "properties": [{ "id": "color", "value": { "fixedColor": "blue", "mode": "fixed" } }]
          },
          {
            "matcher": { "id": "byName", "options": "debug" },
            "properties": [{ "id": "color", "value": { "fixedColor": "gray", "mode": "fixed" } }]
          }
        ]
      }
    },
    {
      "id": 5,
      "title": "Logs",
      "type": "logs",
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 28 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [
        {
          "datasource": { "type": "loki", "uid": "loki" },
          "expr": "{job=\"tna-service\"} | json | __error__=\"\" | level=~\"${level:regex}\" | phase=~\"${phase:regex}\" | agent=~\"${agent:regex}\" | request_id=~\"${request_id:regex}\" | line_format \"[{{.level}}] {{.event}}{{if .agent}} agent={{.agent}}{{end}}{{if .phase}} phase={{.phase}}{{end}}{{if .tool_name}} tool={{.tool_name}}{{end}}{{if .request_id}} req={{.request_id}}{{end}}{{if .duration_ms}} dur={{.duration_ms}}ms{{end}}\"",
          "refId": "A"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none",
        "enableLogDetails": true,
        "prettifyLogMessage": false,
        "sortOrder": "Descending"
      }
    }
  ]
}
