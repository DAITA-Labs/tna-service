{
  "annotations": { "list": [] },
  "title": "TNA Extraction — overview",
  "schemaVersion": 38,
  "version": 1,
  "templating": {
    "list": [
      {
        "name": "request_id",
        "type": "query",
        "label": "Request ID",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values(request_id)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0
      },
      {
        "name": "phase",
        "type": "query",
        "label": "Phase",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"tna-service\"}, phase)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0
      },
      {
        "name": "agent",
        "type": "query",
        "label": "Agent",
        "datasource": { "type": "loki", "uid": "loki" },
        "query": "label_values({job=\"tna-service\"}, agent)",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Extraction latency p95 (s)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(extraction_duration_seconds_bucket[5m])) by (le))",
        "refId": "A"
      }]
    },
    {
      "id": 2,
      "title": "Agent retries (rate / min)",
      "type": "timeseries",
      "gridPos": { "x": 6, "y": 0, "w": 12, "h": 6 },
      "targets": [{
        "expr": "sum(rate(agent_retry_count[1m])) by (agent)",
        "refId": "A"
      }]
    },
    {
      "id": 3,
      "title": "Validator findings (rate / min)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 },
      "targets": [{
        "expr": "sum(rate(validator_findings[1m])) by (check, severity)",
        "refId": "A"
      }]
    },
    {
      "id": 4,
      "title": "PLIs per file",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 },
      "targets": [{
        "expr": "extraction_pli_count",
        "refId": "A"
      }]
    },
    {
      "id": 5,
      "title": "Extraction success rate (%)",
      "type": "stat",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 8 },
      "targets": [{
        "expr": "sum(rate(extractions_total{status=\"success\"}[5m])) / sum(rate(extractions_total[5m])) * 100",
        "refId": "A"
      }]
    },
    {
      "id": 6,
      "title": "Extractions / min by status",
      "type": "timeseries",
      "gridPos": { "x": 8, "y": 12, "w": 16, "h": 8 },
      "targets": [{
        "expr": "sum(rate(extractions_total[1m])) by (status)",
        "refId": "A",
        "legendFormat": "{{status}}"
      }]
    },
    {
      "id": 7,
      "title": "Agent calls / min by agent + status",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(agent_calls_total[1m])) by (agent, status)",
        "refId": "A",
        "legendFormat": "{{agent}} — {{status}}"
      }]
    },
    {
      "id": 8,
      "title": "Agent duration p95 by agent",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 20, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(agent_duration_seconds_bucket[5m])) by (le, agent))",
        "refId": "A",
        "legendFormat": "{{agent}}"
      }]
    },
    {
      "id": 9,
      "title": "LLM tokens / min (input + output stacked)",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 8 },
      "targets": [
        {
          "expr": "sum(rate(agent_tokens_input[1m])) by (agent)",
          "refId": "A",
          "legendFormat": "input — {{agent}}"
        },
        {
          "expr": "sum(rate(agent_tokens_output[1m])) by (agent)",
          "refId": "B",
          "legendFormat": "output — {{agent}}"
        }
      ]
    },
    {
      "id": 10,
      "title": "LLM calls / min by model + status",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(llm_calls_total[1m])) by (model, status)",
        "refId": "A",
        "legendFormat": "{{model}} — {{status}}"
      }]
    },
    {
      "id": 11,
      "title": "Tool calls / min by tool",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 36, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(tool_calls_total[1m])) by (tool_name)",
        "refId": "A",
        "legendFormat": "{{tool_name}}"
      }]
    },
    {
      "id": 12,
      "title": "Tool duration p95 by tool",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 36, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(tool_duration_seconds_bucket[5m])) by (le, tool_name))",
        "refId": "A",
        "legendFormat": "{{tool_name}}"
      }]
    },
    {
      "id": 13,
      "title": "Tool errors / min by tool",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 44, "w": 12, "h": 8 },
      "targets": [{
        "expr": "sum(rate(tool_errors_total[1m])) by (tool_name)",
        "refId": "A",
        "legendFormat": "{{tool_name}}"
      }]
    },
    {
      "id": 14,
      "title": "Phase duration p95 by phase",
      "type": "timeseries",
      "gridPos": { "x": 12, "y": 44, "w": 12, "h": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(extraction_phase_duration_seconds_bucket[5m])) by (le, phase))",
        "refId": "A",
        "legendFormat": "{{phase}}"
      }]
    },
    {
      "id": 15,
      "title": "Logs (filterable by request_id / phase / agent)",
      "type": "logs",
      "gridPos": { "x": 0, "y": 52, "w": 24, "h": 12 },
      "datasource": { "type": "loki", "uid": "loki" },
      "targets": [{
        "datasource": { "type": "loki", "uid": "loki" },
        "expr": "{job=\"tna-service\"} | json | __error__=\"\"",
        "refId": "A"
      }],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "dedupStrategy": "none"
      }
    }
  ]
}
