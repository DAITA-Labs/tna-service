{
  "title": "TNA Overview",
  "uid": "tna-overview",
  "tags": ["tna", "overview"],
  "schemaVersion": 38,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": {},
  "templating": { "list": [] },
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "title": "Total /extract requests",
      "type": "stat",
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "sum(extractions_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 2,
      "title": "Success rate %",
      "type": "stat",
      "gridPos": { "x": 6, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 1
        }
      },
      "targets": [
        {
          "expr": "(sum(extractions_total{status=\"success\"}) / clamp_min(sum(extractions_total), 1)) * 100",
          "refId": "A"
        }
      ]
    },
    {
      "id": 3,
      "title": "xlsx files processed",
      "type": "stat",
      "gridPos": { "x": 12, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "sum(extractions_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 4,
      "title": "Total PLIs extracted",
      "type": "stat",
      "gridPos": { "x": 18, "y": 0, "w": 6, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0
        }
      },
      "targets": [
        {
          "expr": "sum(plis_extracted_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 5,
      "title": "LLM calls",
      "type": "stat",
      "gridPos": { "x": 0, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "targets": [
        {
          "expr": "sum(llm_calls_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 6,
      "title": "Agent calls",
      "type": "stat",
      "gridPos": { "x": 8, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "targets": [
        {
          "expr": "sum(agent_calls_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 7,
      "title": "Tool calls",
      "type": "stat",
      "gridPos": { "x": 16, "y": 6, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "color": { "mode": "fixed", "fixedColor": "green" }
        }
      },
      "targets": [
        {
          "expr": "sum(tool_calls_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 8,
      "title": "LLM failures",
      "type": "stat",
      "gridPos": { "x": 0, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "mappings": [
        {
          "options": { "0": { "text": "0", "color": "green" } },
          "type": "value"
        }
      ],
      "targets": [
        {
          "expr": "sum(llm_calls_total{status=\"failure\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 9,
      "title": "Agent failures",
      "type": "stat",
      "gridPos": { "x": 8, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "mappings": [
        {
          "options": { "0": { "text": "0", "color": "green" } },
          "type": "value"
        }
      ],
      "targets": [
        {
          "expr": "sum(agent_calls_total{status=\"failure\"})",
          "refId": "A"
        }
      ]
    },
    {
      "id": 10,
      "title": "Tool errors",
      "type": "stat",
      "gridPos": { "x": 16, "y": 12, "w": 8, "h": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "colorMode": "value",
        "graphMode": "none",
        "reduceOptions": { "calcs": ["lastNotNull"] }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": 0 },
              { "color": "yellow", "value": 1 },
              { "color": "red", "value": 5 }
            ]
          },
          "color": { "mode": "thresholds" }
        },
        "overrides": []
      },
      "mappings": [
        {
          "options": { "0": { "text": "0", "color": "green" } },
          "type": "value"
        }
      ],
      "targets": [
        {
          "expr": "sum(tool_errors_total)",
          "refId": "A"
        }
      ]
    },
    {
      "id": 11,
      "title": "Token usage over time",
      "type": "timeseries",
      "gridPos": { "x": 0, "y": 18, "w": 24, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "tooltip": { "mode": "multi" },
        "legend": { "displayMode": "list", "placement": "bottom" }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "fillOpacity": 30,
            "stacking": { "mode": "normal", "group": "A" },
            "lineWidth": 1
          }
        }
      },
      "targets": [
        {
          "expr": "sum by (agent) (rate(agent_tokens_input[5m]))",
          "legendFormat": "input — {{agent}}",
          "refId": "A"
        },
        {
          "expr": "sum by (agent) (rate(agent_tokens_output[5m]))",
          "legendFormat": "output — {{agent}}",
          "refId": "B"
        }
      ]
    },
    {
      "id": 12,
      "title": "Agent duration distribution",
      "type": "heatmap",
      "gridPos": { "x": 0, "y": 28, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "decimals": 2
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": false
        },
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(agent_duration_seconds_bucket[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 13,
      "title": "Tool duration distribution",
      "type": "heatmap",
      "gridPos": { "x": 12, "y": 28, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "decimals": 2
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": false
        },
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(tool_duration_seconds_bucket[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 14,
      "title": "LLM call duration distribution",
      "type": "heatmap",
      "gridPos": { "x": 0, "y": 38, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "decimals": 2
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": false
        },
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(llm_inference_duration_seconds_bucket[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    },
    {
      "id": 15,
      "title": "Pipeline phase duration distribution",
      "type": "heatmap",
      "gridPos": { "x": 12, "y": 38, "w": 12, "h": 10 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "options": {
        "calculate": false,
        "yAxis": {
          "axisPlacement": "left",
          "unit": "s",
          "decimals": 2
        },
        "color": {
          "mode": "scheme",
          "scheme": "Spectral",
          "steps": 64,
          "reverse": false
        },
        "tooltip": { "show": true, "yHistogram": true },
        "legend": { "show": true }
      },
      "targets": [
        {
          "expr": "sum by (le) (increase(extraction_phase_duration_seconds_bucket[1m]))",
          "format": "heatmap",
          "legendFormat": "{{le}}",
          "refId": "A"
        }
      ]
    }
  ]
}
