# Optional override for Docker Desktop / Mac / Windows users where
# Promtail's file-tail mount may not work reliably.
#
# Setup (one-time):
#   docker plugin install grafana/loki-docker-driver:latest \
#     --alias loki --grant-all-permissions
#
# Then copy this file:
#   cp docker-compose.override.yml.example docker-compose.override.yml
#
# And `make up` as usual. The api service will ship logs directly to Loki
# via the plugin; Promtail becomes a no-op (it'll find no files to tail and
# idle). You can remove the promtail service from the override if desired.

services:
  api:
    logging:
      driver: loki
      options:
        loki-url: "http://host.docker.internal:3100/loki/api/v1/push"
        loki-batch-size: "400"
        loki-retries: "5"
        # Strip the noisy stream/swarm fields; keep the JSON message.
        keep-file: "true"
        mode: "non-blocking"
